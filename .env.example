# No model API credentials: host subscription performs all model work.
PORT=8787
HOST=127.0.0.1
# Stable public HTTPS origin after deployment; local development only below.
VOCAB_PUBLIC_URL=http://127.0.0.1:8787
# Persistent project data directory, excluded from source control and plugin packages.
VOCAB_DATA_DIR=./data
# VOCAB_DATA_DIR=/data/vocabulary-context
# Required to authorize this personal library; choose >=20 characters, store in deployment secrets.
# VOCAB_OWNER_PASSWORD=
# Copy exact callback from ChatGPT server management if it differs.
VOCAB_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# No unauthenticated production mode exists.
