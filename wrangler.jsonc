{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"vocabulary-context",
  "main":"cloudflare/worker.mjs",
  "compatibility_date":"2026-10-15",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "routes":[{"pattern":"vocab.hellovian.com","custom_domain":true}],
  "alias":{"node:sqlite":"./cloudflare/sqlite-unavailable.mjs"},
  "rules":[{"type":"Text","globs":["**/*.html","**/*.md","**/*.sql"],"fallthrough":true}],
  "durable_objects":{"bindings":[{"name":"VOCAB_LIBRARY","class_name":"VocabularyLibrary"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["VocabularyLibrary"]}],
  "vars":{"VOCAB_PUBLIC_URL":"https://vocab.hellovian.com","VOCAB_REDIRECT_URIS":"https://chatgpt.com/connector_platform_oauth_redirect"}
}
